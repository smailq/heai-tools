{
  "version": 1,
  "unowned": "fail",
  "repositories": {
    "app": {
      "remotePath": "github.com/example/app",
      "localPath": "../app"
    }
  },
  "territories": {
    "platform": {
      "scope": [
        {
          "repository": "app",
          "globs": [
            "architecture.yaml",
            ".github/**",
            "ci/**"
          ]
        }
      ],
      "context": "The map protects everything else."
    },
    "core": {
      "scope": [
        {
          "repository": "app",
          "globs": [
            "src/core/**"
          ]
        }
      ],
      "context": "Invariants: no I/O in the domain model; every aggregate has a test.\n"
    },
    "api": {
      "scope": [
        {
          "repository": "app",
          "globs": [
            "src/api/**"
          ]
        }
      ],
      "dependsOn": [
        "core"
      ]
    }
  }
}
