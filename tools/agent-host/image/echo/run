#!/bin/sh
# A stand-in agent. Reads the prompt, does something small and visible, exits 0.
set -e
prompt=$(cat)
echo "echo-runner: acting as $HEAI_ACTOR in run $HEAI_RUN (task: ${HEAI_TASK:-none})"
echo "echo-runner: prompt was $(printf '%s' "$prompt" | wc -c | tr -d ' ') bytes"

# The first glob under "# Your territories" says where this actor may write.
dir=$(printf '%s' "$prompt" | sed -n 's/^## [^ ]* - `\([^`*]*\).*/\1/p' | head -1 | sed 's:/*$::')
dir=${dir:-.}
mkdir -p "$dir"

if printf '%s' "$prompt" | grep -q 'please request'; then
  mkdir -p "/heai/runs/$HEAI_RUN.requests"
  cat > "/heai/runs/$HEAI_RUN.requests/help.md" <<REQ
---
title: Help requested by $HEAI_ACTOR
territory: $(printf '%s' "$prompt" | sed -n 's/.*please request \([a-z0-9._-]*\).*/\1/p' | head -1)
---

$HEAI_ACTOR needs this done before it can continue run $HEAI_RUN.

Done when: this task is marked done.
REQ
  echo "echo-runner: filed a request; blocked."
  exit 0
fi

echo "note from $HEAI_ACTOR in run $HEAI_RUN" >> "$dir/AGENT-NOTES.md"
git add -A
git commit -q -m "echo-runner: note from $HEAI_ACTOR (${HEAI_TASK:-prompt})"
echo "echo-runner: committed $(git rev-parse --short HEAD) on $(git rev-parse --abbrev-ref HEAD)"
echo "Done: added a note to $dir/AGENT-NOTES.md."
