# image/Containerfile - the base image: the worker, git, jq, and nothing that knows a job.
# Stage one compiles the worker from worker/; stage two is what runs.
# Project tools go in extended images built FROM this one; see example/.
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src
COPY worker/ .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /worker .

FROM docker.io/library/debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl jq ripgrep openssh-client procps \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /worker /heai/bin/worker
RUN mkdir -p /work_queue \
 && git config --system safe.directory '*' \
 && git config --system user.name heai \
 && git config --system user.email heai@localhost

ENV PATH=/heai/bin:$PATH HOME=/root
WORKDIR /work_queue
ENTRYPOINT ["/heai/bin/worker"]
