{
  "name": "@heai-tools/architect",
  "version": "0.1.0",
  "description": "The architecture map as one tool: the reference validator, the map queries other tools need, and the scope gate that checks a diff against its ownership boundaries, as a command and as a library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smailq/heai-tools.git",
    "directory": "tools/architect"
  },
  "homepage": "https://github.com/smailq/heai-tools/tree/main/tools/architect#readme",
  "bugs": {
    "url": "https://github.com/smailq/heai-tools/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "heai-architect": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.8.0"
  }
}
