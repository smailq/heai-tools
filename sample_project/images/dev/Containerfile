# An extended image: the base plus a project's toolchains and agents. Nothing
# here runs a job; a job's run.sh calls whatever this image installed.
# `pod build <tag>` passes the base's tag as BASE.
ARG BASE=heai/pod-base
FROM ${BASE}

RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm python3 \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code
